# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Nunca commite o arquivo .env real.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- MySQL ---
# Se a porta 3306 já estiver em uso no host (ex.: MySQL/PostgreSQL nativo),
# ajuste MYSQL_HOST_PORT para outra porta livre (ex.: 3307). A porta dentro
# do container/rede docker continua sendo 3306.
MYSQL_DATABASE=central_ajuda_ciclo
MYSQL_USER=central_ajuda_ciclo
MYSQL_PASSWORD=central_ajuda_ciclo
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
# O banco de teste usado pelo pytest-django é criado automaticamente pelo
# Django como "test_" + MYSQL_DATABASE (ex.: test_central_ajuda_ciclo).

# --- Portas expostas no host (ajuste se estiverem ocupadas) ---
API_HOST_PORT=8000
FRONTEND_HOST_PORT=8080

# --- Credenciais de demonstração (usadas pelo seed_demo) ---
DEMO_STUDENT_EMAIL=aluno.demo@central-ajuda-ciclo.local
DEMO_STUDENT_PASSWORD=aluno12345
DEMO_AGENT_EMAIL=atendente.demo@central-ajuda-ciclo.local
DEMO_AGENT_PASSWORD=atendente12345

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000/api
VITE_DEMO_MODE=false
